# Required
TARGET_BASE=https://api.example.com

# Optional local bind address
LISTEN_ADDRESS=127.0.0.1:8787

# Optional upstream proxy, for example:
UPSTREAM_PROXY=http://proxy.example.com:8080

# Optional upstream proxy auth
PROXY_USERNAME=someone007
# PROXY_PASSWORD=

# If true and PROXY_PASSWORD is empty, prompt on startup
PROMPT_FOR_PROXY_PASSWORD=true

# Optional TLS behavior for the target server
INSECURE_SKIP_VERIFY=false

# Optional alternate env file path.
# Usually you set this in the shell, not inside .env itself.
# ENV_FILE=/path/to/custom.env
